# Microsoft Entra ID / M365
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-spa-client-id
# API application/client ID or exposed scope audience used by the backend
M365_API_AUDIENCE=your-api-client-id
M365_API_SCOPE=api://your-api-client-id/access_as_user

# Keep this secret server-side. NEVER put it in public/index.html.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Microsoft 365 email address that is the school AI administrator
ADMIN_EMAIL=beheerder@school.be

PORT=3000
