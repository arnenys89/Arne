# Microsoft account login
# The web app uses the Microsoft "common" authority, so users can sign in
# with work/school accounts OR personal Microsoft accounts.
M365_CLIENT_ID=your-app-client-id
M365_API_AUDIENCE=your-api-client-id
M365_API_SCOPE=api://your-api-client-id/access_as_user

# Server-side Microsoft Graph access to the school's SharePoint Lists.
# This tenant is ONLY the data store tenant; it does not restrict login.
SHAREPOINT_TENANT_ID=your-school-tenant-id
SHAREPOINT_SITE_ID=your-sharepoint-site-id
USERS_LIST_ID=AI Gebruikers
TEMPLATES_LIST_ID=AI Sjablonen
USAGE_LIST_ID=AI Gebruik

# Server-side secret. NEVER put this in public browser code.
AZURE_CLIENT_SECRET=your-server-client-secret
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

PORT=3000
