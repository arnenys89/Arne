# Microsoft Entra ID / Microsoft 365
# In de eenvoudige single-app architectuur mag dezelfde appregistratie de SPA + API zijn.
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-app-client-id
M365_CLIENT_SECRET=your-app-client-secret
# API audience; meestal hetzelfde client-ID bij een single-app registratie.
M365_API_AUDIENCE=your-app-client-id
M365_API_SCOPE=api://your-app-client-id/access_as_user

# OpenAI — ALLEEN server-side
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# SharePoint / Microsoft Lists
SHAREPOINT_SITE_ID=your-sharepoint-site-id
# Vul IDs in voor de meest robuuste configuratie; namen werken ook.
USERS_LIST_ID=your-users-list-id
TEMPLATES_LIST_ID=your-templates-list-id
USAGE_LIST_ID=your-usage-list-id
# Alternatief als je eerst met namen wilt testen:
# USERS_LIST_NAME=AI Gebruikers
# TEMPLATES_LIST_NAME=AI Sjablonen
# USAGE_LIST_NAME=AI Gebruik

PORT=3000

# Backwards-compatible aliases: de huidige GitHub Secrets kunnen hiermee rechtstreeks worden gebruikt.
# AZURE_TENANT_ID=<zelfde waarde als M365_TENANT_ID>
# AZURE_CLIENT_ID=<zelfde waarde als M365_CLIENT_ID>
# AZURE_CLIENT_SECRET=<zelfde waarde als M365_CLIENT_SECRET>
