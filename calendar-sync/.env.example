PORT=3100
SYNC_INTERVAL_MINUTES=5
STATE_FILE=./data/calendar-sync-state.json
SYNC_LOOKBACK_DAYS=365
SYNC_LOOKAHEAD_DAYS=730

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-HOST.example.com/api/calendar/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Microsoft 365
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_TENANT_ID=common
M365_REDIRECT_URI=https://YOUR-HOST.example.com/api/calendar/microsoft/callback
M365_REFRESH_TOKEN=
M365_CALENDAR_ID=

# ICS
ICS_URL=
ICS_ENABLED=true

# Write permissions
WRITE_GOOGLE=true
WRITE_MICROSOFT=true
ICS_READ_ONLY=true
